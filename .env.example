# ── Option 1: Cloud (Groq, free, ~1000 requests/day) ──
# Get a FREE key at https://console.groq.com/keys and paste it below.
# Never commit this file or share the key.
GROQ_API_KEY=PASTE_YOUR_KEY_HERE

# ── Option 2: Local (Ollama, 100% no limits, private) ──
# 1. Install Ollama: https://ollama.com/download
# 2. Run: ollama pull llama3.1:8b   (then: ollama serve)
# 3. Comment out GROQ_API_KEY above and uncomment the two lines below:
# NAMYA_API_BASE=http://localhost:11434/v1
# NAMYA_MODEL=llama3.1:8b

PORT=3000
